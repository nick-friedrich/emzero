{
  "name": "emzero",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @emzero/desktop start",
    "lint": "pnpm --filter @emzero/desktop lint",
    "typecheck": "pnpm --filter @emzero/desktop typecheck",
    "test": "pnpm --filter @emzero/desktop test",
    "test:e2e": "pnpm --filter @emzero/desktop test:e2e",
    "build": "pnpm --filter @emzero/desktop package",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e"
  }
}
