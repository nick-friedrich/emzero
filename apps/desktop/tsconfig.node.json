{
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "forge.config.ts",
    "playwright.config.ts",
    "vite.*.config.ts",
    "vitest.config.ts",
    "e2e/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/providers/**/*.json",
    "src/forge-env.d.ts"
  ]
}
